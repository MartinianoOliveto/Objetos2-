import empresa.*
const casado = new Casado()


const martin = new EmpleadoTemporal(nombre = "Martin Gomez", direccion = "Calle Falsa 123",
                    estadoCivil = casado, fechaNacimiento = edadMartin, sueldoBasico = 1000, 
                    fechaDesignacion = "", horasExtra =10)
const edadMartin = new Date(day = 25, month = 7, year = 1980)

const laura = new EmpleadoPermanente(nombre = "Laura Benitez", direccion = "Av.Mitre 450",
                    estadoCivil = casado, fechaNacimiento = edadLaura, sueldoBasico = 3000, 
                    cantDeHijos = 2, antiguedad = 5)
const edadLaura = new Date(day = 10, month = 9, year = 1970)

const blanquiceleste = new Empresa(nombre ="Blanquiceleste S.A", cuit = "30-11223344-9", 
                empleados = #{martin,laura})
describe "Testeando la empresa"{
    test"Testeando total de sueldos netos, que deberia ser de 3767,50"{
        assert.equals(3767.50, blanquiceleste.totalSueldosNetos())
    }
    test"Testeando total de sueldos brutos, que deberia ser de 5050 patacones"{
        assert.equals(5050, blanquiceleste.totalSueldosBrutos())
    }
    test"Testeando total de reteniones, que deberian ser 1282,50 patacones"{
        assert.equals(1282.50, blanquiceleste.totalRetenciones())
    }
}
describe "Testeando sueldo de empleado temporal"{
    test"Edad de Martin"{
        assert.equals(46, martin.edad())
    }
    test"Sueldo bruto de Martin, que deberia ser 1400 patacones"{
        assert.equals(1400,martin.sueldoBruto())
    }
    test"retenciones de obra social a Martin, que deberian ser 140 patacones"{
        assert.equals(140,martin.obraSocial())
    }
    test"retenciones de aportes a Martin, que deberian ser 190 patacones"{
        assert.equals(190, martin.aportes())
    }
    test"Retenciones a Martin, que deberian ser de 330 patacones"{
        assert.equals(330, martin.retenciones())
    }
    test"Sueldo neto de Martin, que deberia ser de 1070 patacones"{
        assert.equals(1070, martin.sueldoNeto())
    }
}
describe"Testeando calculo de sueldo de empleado permanente"{
    test"Edad de Laura"{
        assert.equals(56, laura.edad())
    }
    test"Salario familiar de Laura, que deberia ser de 650 patacones"{
        assert.equals(650, laura.salarioFamiliar())
    }
    test"Salario bruto de Laura, que deberia ser de 3650 patacones"{
        assert.equals(3650, laura.sueldoBruto())
    }
    test"Retenciones por obra social a Laura, que deberian ser de 405 patacones"{
        assert.equals(405, laura.obraSocial())
    }
    test"Retenciones por aportes a Laura, que deberian ser de 547,50 patacones"{
        assert.equals(547.50, laura.aportes())
    }
    test"Retenciones a Laura, que deberian ser de 952,50 patacones"{
        assert.equals(952.50, laura.retenciones())
    }
    test "Salario neto de Laura, que deberia de ser de 2697,50 patacones"{
        assert.equals(2697.50, laura.sueldoNeto())
    }

}
